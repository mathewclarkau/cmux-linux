# Optional systemd --user unit for environments that prefer a supervised
# companion over the in-process `mtyx socket-watchdog` spawn (issue #27).
#
# The headless daemon already auto-spawns a detached watchdog on start, so
# most users do not need this unit. Install it only if you want systemd to
# own the watchdog lifecycle (Restart=on-failure, logout cleanup via the
# user manager).
#
# Example (per session):
#   systemctl --user import-environment
#   systemctl --user set-environment MTYX_WATCH_PID=12345 MTYX_WATCH_SOCKET=/run/user/$UID/mtyx-/main.sock
#   systemctl --user start mtyx-socket-watchdog@main.service
#
# Or rely on the daemon's built-in spawn and leave this file as documentation.

[Unit]
Description=mtyx socket watchdog for %i
Documentation=https://github.com/mathewclarkau/mattyx/issues/27

[Service]
Type=simple
# Expect MTYX_WATCH_PID and MTYX_WATCH_SOCKET in the environment.
ExecStart=/usr/bin/env mtyx socket-watchdog --pid ${MTYX_WATCH_PID} --socket ${MTYX_WATCH_SOCKET}
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
