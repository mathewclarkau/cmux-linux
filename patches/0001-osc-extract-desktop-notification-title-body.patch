@@ -89,6 +89,30 @@ typedef enum GHOSTTY_ENUM_TYPED {
    * the same parser instance. Memory is owned by the parser.
    */
   GHOSTTY_OSC_DATA_CHANGE_WINDOW_TITLE_STR = 1,
+
+  /**
+   * Desktop notification title string data (may be empty).
+   *
+   * Valid for: GHOSTTY_OSC_COMMAND_SHOW_DESKTOP_NOTIFICATION
