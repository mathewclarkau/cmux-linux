     }
 
     return true;
@@ -138,3 +151,33 @@ test "change window title" {
     try testing.expect(commandData(cmd, .change_window_title_str, @ptrCast(&title)));
     try testing.expectEqualStrings("a", std.mem.span(title));
 }
+
+test "show desktop notification" {
+    const testing = std.testing;
+    var p: Parser = undefined;
+    try testing.expectEqual(Result.success, new(
+        &lib.alloc.test_allocator,
+        &p,
+    ));
+    defer free(p);
+
+    // OSC 9 ; <body> ST
+    for ("9;Hello world") |ch| next(p, ch);
+    const cmd = end(p, 0x1b);
+    try testing.expectEqual(.show_desktop_notification, commandType(cmd));
+
+    var title: [*:0]const u8 = undefined;
+    try testing.expect(commandData(cmd, .desktop_notification_title_str, @ptrCast(&title)));
+    try testing.expectEqualStrings("", std.mem.span(title));
+
+    var body: [*:0]const u8 = undefined;
+    try testing.expect(commandData(cmd, .desktop_notification_body_str, @ptrCast(&body)));
+    try testing.expectEqualStrings("Hello world", std.mem.span(body));
+
+    // Extraction fails cleanly against a command of the wrong type.
+    next(p, '0');
+    next(p, ';');
+    next(p, 'a');
+    const title_cmd = end(p, 0);
+    try testing.expect(!commandData(title_cmd, .desktop_notification_title_str, @ptrCast(&title)));
+}
