+  GHOSTTY_OSC_DATA_DESKTOP_NOTIFICATION_BODY_STR = 3,
   GHOSTTY_OSC_DATA_MAX_VALUE = GHOSTTY_ENUM_MAX_VALUE,
 } GhosttyOscCommandData;
 
